[Unit]
Description=Weekly KWin stable-update proposals

[Timer]
OnCalendar=Mon *-*-* 03:10:00 UTC
RandomizedDelaySec=5min
Persistent=true
Unit=kwin-upstream-publisher.service

[Install]
WantedBy=timers.target
