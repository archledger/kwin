[Unit]
Description=Report a failed KWin upstream publisher invocation

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -Es %h/.local/lib/kwin-upstream-publisher/publisher_report.py
WorkingDirectory=%h
UMask=0077
TimeoutStartSec=30s
NoNewPrivileges=yes
MemoryMax=64M
CPUQuota=100%
